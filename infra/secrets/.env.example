# Copy this to .env at the repo root (or wherever docker-compose.yml expects it) and fill in real values. Never commit .env.

# ==========================================
# Database (PostgreSQL) — Tasks 001, 003, 005
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ekcp_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Cache / Broker (Redis) — Tasks 001, 003
# ==========================================
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ==========================================
# Object Storage (MinIO / S3) — Tasks 001, 003
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==========================================
# API Server (FastAPI) — Task 001
# ==========================================
API_PORT=8000
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# ==========================================
# Web Frontend (React / Vite) — Task 002
# ==========================================
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
WEB_BUILD_TARGET=runner

# ==========================================
# Identity & Auth — not yet used — Phase 3
# ==========================================
# JWT_SECRET_KEY=dev_secret_key_change_in_production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# AI / LLM Gateway — not yet used — Phase 8
